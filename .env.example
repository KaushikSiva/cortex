# DEMO uses explicitly labeled synthetic protocol fixtures; REAL requires Gradium.
CORTEX_MODE=DEMO
PORT=3000
GRADIUM_API_KEY=
# Optional speech output: Michelle (Indian English catalog voice): lt88kyLfD8Mqemla
GRADIUM_VOICE_ID=
PIPECAT_API_URL=http://127.0.0.1:8003
# General Compute takes precedence when configured. SambaNova is optional.
GENERAL_COMPUTE_API_KEY=
GENERAL_COMPUTE_MODEL=gpt-oss-120b
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
MEMORIES_API_KEY=
# Optional existing Datalake collection; otherwise created and persisted locally.
MEMORIES_COLLECTION_ID=
# Optional override; a project-local FFmpeg binary is installed by npm.
FFMPEG_PATH=
JEV_API_KEY=
EDGEONE_EXECUTION_URL=
EDGEONE_EXECUTION_TOKEN=
MUJOCO_API_URL=http://127.0.0.1:8002
# Remote deployment requires an authenticated transport to the local control runtime.
CORTEX_PUBLIC_RUNTIME_URL=
# Optional: locally captured and aligned Gaussian reconstruction manifest.
NEXT_PUBLIC_SPLAT_MANIFEST=
TENCENT_SECRECT_ID=
TENCENT_SECRECT_KEY=
