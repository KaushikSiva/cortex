    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "urdf-loader": "^0.13.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.0",
    "tailwindcss": "^4.1.0",
